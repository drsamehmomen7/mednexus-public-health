# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Project-local portable Python runtime (recovery environment)
.runtime/
backend/venv_recovery/

# Downloaded model weights — reproducible via scripts/download_gliner_model.py,
# not source code. Also far too large for a normal git repo (600MB+).
backend/models/

# Generated synthetic reports — reproducible with a fixed seed via
# scripts/generate_synthetic_reports.py, so committing 500 text files plus
# ground_truth.json would just be noise in every diff.
backend/data/synthetic_reports/

# PDFs stay local — real/test reports must never be committed. Only the
# synthetic fixtures under backend/tests/fixtures/ are allowed.
*.pdf
!backend/tests/fixtures/*.pdf
backend/data/Test Reports/
backend/data/pdf_test_reports/

# Environment/secrets — never commit these
.env
*.env

# Editor / OS clutter
.vscode/
.DS_Store
Thumbs.db
